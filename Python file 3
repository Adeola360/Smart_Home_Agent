/* ============================================================
   RENDERING + SCORING
   ============================================================ */
const state = { level:0, answers:{}, checked:{}, selfmark:{} };

const el = (t,c,h)=>{const e=document.createElement(t); if(c)e.className=c; if(h!==undefined)e.innerHTML=h; return e;};
const key = (li,qi)=>li+"_"+qi;

function marksFor(q){
  if(q.type==="mcq") return 1;
  if(q.type==="multi") return q.marks||q.answers.length;
  if(q.type==="classify"||q.type==="match") return q.items.length;
  if(q.type==="written") return q.marks;
  return 1;
}
function totalMarks(){
  let t=0; DATA.forEach(l=>l.questions.forEach(q=>t+=marksFor(q))); return t;
}
function earnedFor(li,qi){
  const q=DATA[li].questions[qi], k=key(li,qi);
  if(q.type==="written") return state.selfmark[k]||0;
  if(!state.checked[k]) return 0;
  const a=state.answers[k];
  if(q.type==="mcq") return a===q.answer?1:0;
  if(q.type==="multi"){
    const sel=a||[]; const right=sel.filter(i=>q.answers.includes(i)).length;
    const wrong=sel.filter(i=>!q.answers.includes(i)).length;
    return Math.max(0,right-wrong);
  }
  if(q.type==="classify"||q.type==="match"){
    const sel=a||[]; let n=0;
    q.items.forEach((it,i)=>{ if(sel[i]===it.answer) n++; });
    return n;
  }
  return 0;
}
function earnedTotal(){
  let t=0; DATA.forEach((l,li)=>l.questions.forEach((q,qi)=>t+=earnedFor(li,qi))); return t;
}
function levelTotals(li){
  let e=0,m=0;
  DATA[li].questions.forEach((q,qi)=>{ e+=earnedFor(li,qi); m+=marksFor(q); });
  return {e,m};
}
function levelAttempted(li){
  return DATA[li].questions.every((q,qi)=>{
    const k=key(li,qi);
    return q.type==="written" ? state.selfmark[k]!==undefined : state.checked[k];
  });
}

function updateChip(){
  const e=earnedTotal(), m=totalMarks();
  document.getElementById("chip").textContent = e+" / "+m+" marks";
  document.getElementById("bar").style.width = (m? (e/m*100):0)+"%";
  document.querySelectorAll("#nav button").forEach((b,i)=>{
    if(i<DATA.length){
      const done=levelAttempted(i);
      b.innerHTML = (done?'<span class="tick">✓</span> ':'')+DATA[i].name;
    }
  });
}

function buildNav(){
  const nav=document.getElementById("nav"); nav.innerHTML="";
  DATA.forEach((l,i)=>{
    const b=el("button",null,l.name);
    b.onclick=()=>{ state.level=i; render(); window.scrollTo(0,0); };
    nav.appendChild(b);
  });
  const r=el("button",null,"Results");
  r.onclick=()=>{ state.level=DATA.length; render(); window.scrollTo(0,0); };
  nav.appendChild(r);
}

function setCurrentNav(){
  document.querySelectorAll("#nav button").forEach((b,i)=>{
    b.setAttribute("aria-current", i===state.level ? "true":"false");
  });
}

/* ---------- question renderers ---------- */
function renderMCQ(q,li,qi,wrap){
  const k=key(li,qi), opts=el("div","opts");
  q.options.forEach((o,i)=>{
    const lab=el("label","opt");
    const inp=el("input"); inp.type="radio"; inp.name=k; inp.value=i;
    if(state.answers[k]===i) inp.checked=true;
    if(state.checked[k]) inp.disabled=true;
    inp.onchange=()=>{ state.answers[k]=i; };
    lab.appendChild(inp); lab.appendChild(el("span",null,o));
    if(state.checked[k]){
      if(i===q.answer) lab.classList.add("correct");
      else if(state.answers[k]===i) lab.classList.add("wrong");
    }
    opts.appendChild(lab);
  });
  wrap.appendChild(opts);
}
function renderMulti(q,li,qi,wrap){
  const k=key(li,qi), opts=el("div","opts");
  if(!state.answers[k]) state.answers[k]=[];
  q.options.forEach((o,i)=>{
    const lab=el("label","opt");
    const inp=el("input"); inp.type="checkbox"; inp.value=i;
    if(state.answers[k].includes(i)) inp.checked=true;
    if(state.checked[k]) inp.disabled=true;
    inp.onchange=()=>{
      const arr=state.answers[k];
      if(inp.checked){ if(!arr.includes(i))arr.push(i); }
      else state.answers[k]=arr.filter(x=>x!==i);
    };
    lab.appendChild(inp); lab.appendChild(el("span",null,o));
    if(state.checked[k]){
      const sel=state.answers[k].includes(i), right=q.answers.includes(i);
      if(sel&&right) lab.classList.add("correct");
      else if(sel&&!right) lab.classList.add("wrong");
      else if(!sel&&right) lab.classList.add("missed");
    }
    opts.appendChild(lab);
  });
  wrap.appendChild(opts);
}
function renderRows(q,li,qi,wrap){
  const k=key(li,qi), rows=el("div","rows");
  if(!state.answers[k]) state.answers[k]=[];
  q.items.forEach((it,i)=>{
    const row=el("div","row");
    row.appendChild(el("div",null,it.text));
    const sel=el("select");
    sel.appendChild(el("option",null,"— choose —"));
    q.options.forEach(o=>{
      const op=el("option",null,o); op.value=o;
      if(state.answers[k][i]===o) op.selected=true;
      sel.appendChild(op);
    });
    sel.onchange=()=>{ state.answers[k][i]=sel.value; };
    if(state.checked[k]){
      sel.disabled=true;
      if(state.answers[k][i]===it.answer) row.classList.add("correct");
      else{ row.classList.add("wrong"); }
    }
    row.appendChild(sel);
    if(state.checked[k] && state.answers[k][i]!==it.answer){
      row.appendChild(el("div","fix","Correct answer: "+it.answer));
    }
    rows.appendChild(row);
  });
  wrap.appendChild(rows);
}
function renderWritten(q,li,qi,wrap){
  const k=key(li,qi), box=el("div","written");
  if(q.scenario) box.appendChild(el("div","scenario","<b>Scenario</b>"+q.scenario));
  if(q.bullets){
    const ul=el("ul","revise"); q.bullets.forEach(b=>ul.appendChild(el("li",null,b)));
    const c=el("div","hint","<b>In your answer you should:</b>"); c.appendChild(ul); box.appendChild(c);
  }
  const ta=el("textarea");
  ta.placeholder="Write your answer here…";
  ta.value=state.answers[k]||"";
  ta.oninput=()=>{ state.answers[k]=ta.value; };
  box.appendChild(ta);

  const btnRow=el("div"); btnRow.style.marginTop="12px";
  const reveal=el("button","btn ghost","Reveal model answer and mark scheme");
  btnRow.appendChild(reveal); box.appendChild(btnRow);

  const model=el("div","model");
  model.appendChild(el("h4",null,"Distinction-standard model answer"));
  q.model.forEach(p=>model.appendChild(el("p",null,p)));
  box.appendChild(model);

  const crit=el("div","criteria");
  crit.appendChild(el("h4",null,"Mark yourself against the mark scheme"));
  crit.appendChild(el("p","sub","Tick each point your own answer actually made. Be strict — the examiner will be. Each point is worth 1 mark."));
  const scoreLine=el("div","self-score");
  function recalc(){
    const n=[...crit.querySelectorAll("input")].filter(i=>i.checked).length;
    state.selfmark[k]=Math.min(n,q.marks);
    scoreLine.innerHTML='<span>Your self-assessed mark</span><span class="val">'+state.selfmark[k]+" / "+q.marks+"</span>";
    updateChip();
  }
  q.criteria.forEach(c=>{
    const lab=el("label","crit");
    const inp=el("input"); inp.type="checkbox";
    inp.onchange=recalc;
    lab.appendChild(inp); lab.appendChild(el("span",null,c));
    crit.appendChild(lab);
  });
  crit.appendChild(scoreLine);
  box.appendChild(crit);

  reveal.onclick=()=>{
    model.classList.add("show"); crit.classList.add("show");
    reveal.disabled=true; reveal.textContent="Model answer shown below";
    if(state.selfmark[k]===undefined){ state.selfmark[k]=0; }
    recalc();
  };
  if(state.selfmark[k]!==undefined){
    model.classList.add("show"); crit.classList.add("show");
    reveal.disabled=true; reveal.textContent="Model answer shown below";
    scoreLine.innerHTML='<span>Your self-assessed mark</span><span class="val">'+state.selfmark[k]+" / "+q.marks+"</span>";
  } else {
    scoreLine.innerHTML='<span>Your self-assessed mark</span><span class="val">– / '+q.marks+"</span>";
  }
  wrap.appendChild(box);
}

/* ---------- level renderer ---------- */
function renderLevel(li){
  const L=DATA[li], main=document.getElementById("main");
  main.innerHTML="";

  const head=el("div","card level-head");
  head.style.borderLeftColor=L.colour;
  head.appendChild(el("h2",null,L.title));
  head.appendChild(el("p",null,L.blurb));
  const meta=el("div","level-meta");
  L.meta.forEach(m=>meta.appendChild(el("span","tag",m)));
  const t=levelTotals(li);
  meta.appendChild(el("span","tag grey",t.m+" marks available"));
  head.appendChild(meta);
  main.appendChild(head);

  if(L.recap && L.recap.length){
    const rc=el("div","card recap");
    rc.appendChild(el("h3",null,"Before you start — what you need to know"));
    rc.appendChild(el("p","lead","Read this through first. Everything tested on this level is covered here, in the same words the specification uses."));
    const body=el("div");
    L.recap.forEach(r=>{
      const item=el("div","recap-item");
      item.appendChild(el("h4",null,r.h));
      item.insertAdjacentHTML("beforeend", r.b);
      body.appendChild(item);
    });
    rc.appendChild(body);
    const tog=el("button","btn grey recap-toggle","Hide the recap");
    tog.onclick=()=>{
      const hidden=body.style.display==="none";
      body.style.display=hidden?"":"none";
      tog.textContent=hidden?"Hide the recap":"Show the recap";
    };
    rc.appendChild(tog);
    main.appendChild(rc);
  }

  const card=el("div","card");
  L.questions.forEach((q,qi)=>{
    const k=key(li,qi);
    const wrap=el("div","q");
    const hd=el("div","q-head");
    hd.appendChild(el("div","q-num","Q"+(qi+1)));
    hd.appendChild(el("div","q-text",q.q));
    hd.appendChild(el("div","q-marks","["+marksFor(q)+"]"));
    wrap.appendChild(hd);
    wrap.appendChild(el("div","q-ref",q.ref+" · "+q.ao));
    if(q.teach) wrap.appendChild(el("div","teach","<b>Know this first</b>"+q.teach));

    if(q.type==="mcq") renderMCQ(q,li,qi,wrap);
    else if(q.type==="multi") renderMulti(q,li,qi,wrap);
    else if(q.type==="classify"||q.type==="match") renderRows(q,li,qi,wrap);
    else if(q.type==="written") renderWritten(q,li,qi,wrap);

    if(q.type!=="written"){
      const fb=el("div","feedback");
      if(state.checked[k]){
        const got=earnedFor(li,qi), max=marksFor(q);
        fb.classList.add("show", got===max?"good":"bad");
        fb.innerHTML="<b>"+got+" / "+max+" marks</b>"+q.explain;
      }
      wrap.appendChild(fb);
    }
    card.appendChild(wrap);
  });

  const acts=el("div","actions");
  const check=el("button","btn","Check this level");
  check.onclick=()=>{
    L.questions.forEach((q,qi)=>{ if(q.type!=="written") state.checked[key(li,qi)]=true; });
    renderLevel(li); updateChip();
    document.querySelector(".level-result").scrollIntoView({behavior:"smooth",block:"center"});
  };
