    res.innerHTML="<strong>"+t.e+" / "+t.m+"</strong> on "+L.name+" ("+pct+"%). "+
      (pct>=75?"Distinction standard on this level — move on.":
       pct>=60?"Merit standard. Re-read the feedback on anything you lost marks on before moving up.":
       pct>=40?"Pass standard. Go back over the reference material for this level before the next one.":
       "Below pass standard on this level. Review the teacher slides for these topics, then reset and try again.");
  }
  card.appendChild(res);
  main.appendChild(card);
}

/* ---------- results ---------- */
function renderResults(){
  const main=document.getElementById("main"); main.innerHTML="";
  const e=earnedTotal(), m=totalMarks(), pct=m?Math.round(e/m*100):0;

  const head=el("div","card level-head");
  head.style.borderLeftColor="var(--accent)";
  head.appendChild(el("h2",null,"Your results"));
  head.appendChild(el("p",null,"Indicative only. Auto-marked sections are objective; written sections use your own self-assessment against the mark scheme, so be honest about what you actually wrote."));
  main.appendChild(head);

  const card=el("div","card");
  const big=el("div","big-score");
  big.appendChild(el("div","pct",pct+"%"));
  big.appendChild(el("div","of",e+" out of "+m+" marks"));
  let g="u",gl="Below pass standard";
  if(pct>=75){g="d";gl="Distinction standard";}
  else if(pct>=60){g="m";gl="Merit standard";}
  else if(pct>=40){g="p";gl="Pass standard";}
  big.appendChild(el("div","grade "+g,gl));
  card.appendChild(big);

  // by level
  card.appendChild(el("h3",null,"By level"));
  const t1=el("table","bd");
  t1.innerHTML="<tr><th>Level</th><th>Focus</th><th></th><th>Marks</th></tr>";
  DATA.forEach((L,li)=>{
    const t=levelTotals(li), p=t.m?Math.round(t.e/t.m*100):0;
    const tr=el("tr");
    tr.innerHTML="<td><b>"+L.name+"</b></td><td>"+L.title.split("· ")[1]+
      "</td><td><div class='meter'><i style='width:"+p+"%'></i></div></td>"+
      "<td class='n'>"+t.e+" / "+t.m+"</td>";
    t1.appendChild(tr);
  });
  card.appendChild(t1);

  // by content area
  const areas={A:"Learning aim A — Cloud technologies and tools in organisations",
               B:"Learning aim B — Design and deploy a cloud collaboration service",
               C:"Learning aim C — Manage and review a cloud collaboration service"};
  const av={}; Object.keys(areas).forEach(a=>av[a]={e:0,m:0});
  DATA.forEach((L,li)=>L.questions.forEach((q,qi)=>{
    if(!av[q.area]) av[q.area]={e:0,m:0};
    av[q.area].e+=earnedFor(li,qi); av[q.area].m+=marksFor(q);
  }));
  card.appendChild(el("h3",null,"By learning aim"));
  const t2=el("table","bd");
  t2.innerHTML="<tr><th>Area</th><th></th><th>Marks</th></tr>";
  Object.keys(areas).forEach(a=>{
    if(!av[a].m) return;
    const p=Math.round(av[a].e/av[a].m*100);
    const tr=el("tr");
    tr.innerHTML="<td>"+areas[a]+"</td><td><div class='meter'><i style='width:"+p+"%'></i></div></td><td class='n'>"+av[a].e+" / "+av[a].m+"</td>";
    t2.appendChild(tr);
  });
  card.appendChild(t2);

  // by AO
  const ao={}; DATA.forEach((L,li)=>L.questions.forEach((q,qi)=>{
    const list=q.ao.split("/").map(s=>s.trim());
    list.forEach(a=>{ ao[a]=ao[a]||{e:0,m:0}; ao[a].e+=earnedFor(li,qi)/list.length; ao[a].m+=marksFor(q)/list.length; });
  }));
  card.appendChild(el("h3",null,"By assessment criterion"));
  const t3=el("table","bd");
  t3.innerHTML="<tr><th>Criterion</th><th></th><th>Marks</th></tr>";
  Object.keys(ao).sort().forEach(a=>{
    const p=Math.round(ao[a].e/ao[a].m*100);
    const tr=el("tr");
    tr.innerHTML="<td>"+a+"</td><td><div class='meter'><i style='width:"+p+"%'></i></div></td><td class='n'>"+Math.round(ao[a].e)+" / "+Math.round(ao[a].m)+"</td>";
    t3.appendChild(tr);
  });
  card.appendChild(t3);

  // revision list
  const weak=[];
  DATA.forEach((L,li)=>L.questions.forEach((q,qi)=>{
    const got=earnedFor(li,qi), max=marksFor(q);
    if(max>0 && got/max < 0.6 && (state.checked[key(li,qi)]||state.selfmark[key(li,qi)]!==undefined)){
      if(!weak.includes(q.ref)) weak.push(q.ref);
    }
  }));
  card.appendChild(el("h3",null,"What to revise next"));
  if(weak.length){
    const ul=el("ul","revise");
    weak.forEach(w=>ul.appendChild(el("li",null,w)));
    card.appendChild(ul);
  } else {
    card.appendChild(el("p","hint","Nothing flagged yet — either you have not checked your answers, or you scored above 60% on every topic you attempted."));
  }

  const acts=el("div","actions");
  const pr=el("button","btn","Print / save as PDF");
  pr.onclick=()=>window.print();
  acts.appendChild(pr);
  const back=el("button","btn ghost","Back to Level 1");
  back.onclick=()=>{ state.level=0; render(); window.scrollTo(0,0); };
  acts.appendChild(back);
  const clr=el("button","btn grey","Reset the whole test");
  clr.onclick=()=>{
    if(confirm("Clear every answer and start again?")){
      state.answers={}; state.checked={}; state.selfmark={}; state.level=0; render(); window.scrollTo(0,0);
    }
  };
  acts.appendChild(clr);
  card.appendChild(acts);
  main.appendChild(card);
}

function render(){
  setCurrentNav();
  if(state.level>=DATA.length) renderResults();
  else renderLevel(state.level);
  updateChip();
}

buildNav();
render();
</script>
