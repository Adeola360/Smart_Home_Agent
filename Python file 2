    else L.push(["Lower data protection risk","Without personal data, UK GDPR largely falls away, but check for hidden personal data such as names in documents, email addresses and photographs."]);
    if(a.loc==="UK region") L.push(["Data location","Data at rest stays in the UK, which simplifies compliance. Check where backups, support staff and telemetry are located, as access from abroad can still count as a transfer."]);
    if(a.loc==="EEA region") L.push(["Transfer to the EEA","The UK has adequacy regulations for the EEA, so transfers are allowed, but record them in your documentation and keep an eye on future changes."]);
    if(a.loc==="US region"){ L.push(["Restricted transfer to the US","Under UK GDPR this is a restricted transfer. It is lawful if the provider is certified under the UK Extension to the EU-US Data Privacy Framework, or if you use the International Data Transfer Agreement with a transfer risk assessment."]); risk+= a.pd==="Yes"?2:0; }
    if(a.loc==="Not stated by the provider"){ L.push(["Unknown location: red flag","You cannot meet your UK GDPR obligations if you do not know where the data is. Ask the provider in writing, or choose another provider."]); risk+=2; }
    if(a.own==="US"){ L.push(["Provider nationality and the CLOUD Act","US law can require a US provider to produce data it controls wherever it is stored. Microsoft France told a French Senate inquiry in June 2025 that it could not guarantee EU-hosted data would never be handed to US authorities. For most organisations the risk is low, but it should be assessed for highly sensitive data."]); risk++; }
    if(a.own==="EU") L.push(["EU provider","EU law and the EU Data Act apply to the provider. The Data Act gives customers switching rights and removes switching charges in stages, which helps exit planning."]);
    if(a.own==="UK") L.push(["UK provider","A single legal system for the contract and disputes. Check whether the UK provider itself subcontracts to a hyperscaler, which would bring back the issues above."]);
    if(a.keys==="Customer-managed keys") L.push(["Customer-managed keys","Holding your own keys limits what the provider can hand over or read, which reduces jurisdiction risk. It also makes you responsible for key backup: lose the key and you lose the data."]);
    else { L.push(["Provider-managed keys","Simpler to run, but the provider can technically decrypt your data. Consider customer-managed keys for the most sensitive folders."]); risk+= a.own==="US"?1:0; }
