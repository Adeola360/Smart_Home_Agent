function renderCost(m){
  head(m,"Elasticity and cost simulator","Change the organisation's workload and prices. The chart compares a server bought for peak demand with a pay-as-you-grow cloud service that tracks demand. All prices are illustrative. Use what you find to support A4 cost arguments: pay-as-you-grow, idle capacity and total cost of ownership.",["A1 rapid elasticity","A1 measured service","A4 cost","A.M1 / A.D1"],"var(--l2)");
  const c=el("div","card");
  const P={staff:38,peakX:1.5,peakM:3,capex:14000,life:5,run:350,onUser:120,perUser:18,tb:4,perTB:20};
  const F=[
    ["staff","Staff at normal workload",5,250,1,""],
    ["peakX","Peak multiplier (contractors, busy season)",1,3,0.1,"×"],
    ["peakM","Number of peak months per year",0,6,1,""],
    ["capex","Server, licences and install (one-off, £)",2000,60000,500,"£"],
    ["life","Server lifetime (years)",3,7,1,""],
    ["run","On-premises running and support (£ per month)",0,2000,25,"£"],
    ["onUser","On-premises software licences (£ per user per year)",0,400,10,"£"],
    ["perUser","Cloud subscription (£ per user per month)",3,40,1,"£"],
    ["tb","Cloud storage beyond allowance (TB)",0,40,1,""],
    ["perTB","Extra cloud storage (£ per TB per month)",0,60,1,"£"]
  ];
  const form=el("div","sliders");
  F.forEach(([k,label,min,max,step,u])=>{
    const w=el("label","slider");
    const top=el("div","s-top","<span>"+label+"</span><b id='v_"+k+"'></b>");
    const inp=el("input"); inp.type="range"; inp.min=min; inp.max=max; inp.step=step; inp.value=P[k];
    inp.oninput=()=>{P[k]=+inp.value; calc();};
    w.appendChild(top); w.appendChild(inp); form.appendChild(w);
  });
  c.appendChild(form);
  const chart=el("div","chart"); c.appendChild(chart);
  const out=el("div","kpis"); c.appendChild(out);
  const verdict=el("div","teach"); c.appendChild(verdict);
  m.appendChild(c);

  const q=el("div","card");
  q.appendChild(el("h3",null,"Use the simulator"));
  const ol=el("ol","tasks");
  ["The on-premises option needs licences for every user at peak, because software is bought for the most users you will ever have. How does this change the comparison?",
   "Set the peak multiplier to 1.0. Which option is cheaper over five years now, and why does elasticity no longer help?",
   "Set 3 peak months at 2.5×. How much of the server's capacity sits idle across the year? Link this to rapid elasticity.",
   "Raise extra cloud storage to 30 TB. At what point does the cloud stop being cheaper? What does this tell you about large CAD archives?",
   "Write one sentence for A.D1 that uses a figure from the simulator to justify a recommendation for Harbour & Lane."].forEach(s=>ol.appendChild(el("li",null,s)));
  q.appendChild(ol);
  const rv=el("button","btn ghost","Show discussion points"); const md=el("div","model");
  md.innerHTML="<h4>Discussion points</h4><p>With no peak, the server is sized exactly to demand, so elasticity gives no saving and the comparison becomes a straight capital versus subscription question; over five years a server can win if running costs are low.</p><p>With big peaks, the server must be sized for the peak all year, so capacity is idle in most months. The cloud tracks demand, which is rapid elasticity plus measured service in action.</p><p>Storage-heavy organisations can find cloud storage charges overtake the savings. Archiving old projects to a cheaper tier, or a hybrid design, can reduce this.</p><p>A strong sentence: Over five years the simulator shows pay-as-you-grow costing about £X compared with £Y for a peak-sized server, with Z% of server capacity idle, so the subscription model is preferable provided archive storage is controlled.</p>";
  rv.onclick=()=>{md.classList.add("show"); rv.disabled=true; mark("cost");};
  q.appendChild(rv); q.appendChild(md); m.appendChild(q);

  function calc(){
    F.forEach(([k,,,,,u])=>{ const v=document.getElementById("v_"+k); v.textContent=(u==="£"?"£"+(+P[k]).toLocaleString("en-GB"):(+P[k]).toLocaleString("en-GB")+(u==="×"?"×":"")); });
    const months=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
    const peakIdx=[8,9,10,2,3,4].slice(0,P.peakM); // autumn first
    const demand=months.map((_,i)=>Math.round(P.staff*(peakIdx.includes(i)?P.peakX:1)));
    const cap=Math.max(...demand);
    const used=demand.reduce((a,b)=>a+b,0), avail=cap*12;
    const idle=avail?Math.round((1-used/avail)*100):0;
    const onYear=P.capex/P.life+P.run*12+P.onUser*cap;
    const cloudYear=used*P.perUser+P.tb*P.perTB*12;
    const on5=onYear*5, cl5=cloudYear*5;
    // chart
    const W=820,H=240,pl=44,pr=12,pt=14,pb=28, step=[5,10,20,25,50,100,200,250,500,1000].find(s=>s*4>=cap*1.1)||1000, maxY=step*4;
    const x=i=>pl+(W-pl-pr)*(i+0.5)/12, y=v=>pt+(H-pt-pb)*(1-v/maxY), bw=(W-pl-pr)/12*0.6;
    let s="<svg viewBox='0 0 "+W+" "+H+"' role='img' aria-label='Monthly demand compared with fixed server capacity'>";
    for(let g=0;g<=4;g++){const v=maxY*g/4; s+="<line x1='"+pl+"' x2='"+(W-pr)+"' y1='"+y(v)+"' y2='"+y(v)+"' class='gl'/><text x='"+(pl-6)+"' y='"+(y(v)+4)+"' class='ax' text-anchor='end'>"+Math.round(v)+"</text>";}
    demand.forEach((d,i)=>{ s+="<rect x='"+(x(i)-bw/2)+"' y='"+y(d)+"' width='"+bw+"' height='"+(y(0)-y(d))+"' class='bar-c' rx='3'><title>"+months[i]+": "+d+" users</title></rect><text x='"+x(i)+"' y='"+(H-8)+"' class='ax' text-anchor='middle'>"+months[i]+"</text>"; });
    s+="<line x1='"+pl+"' x2='"+(W-pr)+"' y1='"+y(cap)+"' y2='"+y(cap)+"' class='capline'/><text x='"+(W-pr)+"' y='"+(y(cap)-6)+"' class='lbl' text-anchor='end'>Server sized for peak: "+cap+" users</text>";
    s+="</svg><p class='legend'><span class='sw c'></span>Cloud capacity used and paid for each month (tracks demand) <span class='sw s'></span>Fixed on-premises capacity</p>";
    chart.innerHTML=s;
    const f=n=>"£"+Math.round(n).toLocaleString("en-GB");
    out.innerHTML="<div class='kpi'><span>On-premises per year</span><b>"+f(onYear)+"</b></div><div class='kpi'><span>Cloud per year</span><b>"+f(cloudYear)+"</b></div><div class='kpi'><span>Five-year difference</span><b>"+f(Math.abs(on5-cl5))+"</b><small>"+(cl5<on5?"cloud cheaper":"on-premises cheaper")+"</small></div><div class='kpi'><span>Server capacity idle</span><b>"+idle+"%</b></div>";
    verdict.innerHTML="<b>What this shows</b>Over five years the cloud option costs "+f(cl5)+" and the server option "+f(on5)+". "+(idle>15?"The server sits "+idle+"% idle because it is bought for the peak, which is the cost that rapid elasticity avoids. ":"Demand is fairly flat, so elasticity saves little here. ")+"Remember the figures the simulator cannot see: staff time to patch the server, the risk of a single site, and the cost of downtime.";
  }
  calc();
}

